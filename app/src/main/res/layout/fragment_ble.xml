<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_ble_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".BleFragment">

    <TextView
        android:id="@+id/main_text_in_ble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/horizontal_slide_text_to_start_sacn_chinese"
        android:textSize="24sp"
        android:textColor="@color/text_color"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="@id/scan_state_indicator_in_ble"
        app:layout_constraintBottom_toBottomOf="@id/scan_state_indicator_in_ble"
        app:layout_constraintStart_toEndOf="@id/scan_state_indicator_in_ble"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="24dp"
        />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/scan_state_indicator_in_ble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="@color/blue"
        app:trackColor="@color/light_blue"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"
        />

    <ImageView
        android:id="@+id/scan_state_image_in_ble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/radar"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="@id/scan_state_indicator_in_ble"
        app:layout_constraintStart_toStartOf="@id/scan_state_indicator_in_ble"
        android:layout_marginTop="0dp"
        android:layout_marginStart="0dp"
        />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scan_state_indicator_in_ble"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingTop="24dp"
        >
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/scan_result_recycler_view_in_ble"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
